allow audioserver default_android_service service_manager find
allow domain system_file file { read open getattr map }
allow zygote vendor_file file { read open getattr map }
# Native state persistence: the effect instance is created by the framework
# inside the audio HAL (uid 1041/gid 1005), which is the process that reads and
# writes /data/vendor/audio/jamesdsp_state.bin.
# Path-scoped only; no domain-wide permissions. rename/unlink are required
# because the engine saves via  .tmp.<pid> + fsync + rename.  dir 'read' is
# needed as well: the engine inotify-watches the directory to hot-reload a
# state file written by another process (without it it falls back to polling).
allow hal_audio_default vendor_audio_data_file dir { search read write add_name remove_name create getattr }
allow hal_audio_default vendor_audio_data_file file { read write open create getattr setattr map unlink rename }
# MediaTek devices run the audio effect HAL in their own domain (mtk_hal_audio,
# verified on xaga / Android 15: /proc/<hal>/attr/current = u:r:mtk_hal_audio:s0).
# Vendor policy dontaudits vendor_audio_data_file there, so a missing rule shows
# up only as "JamesDSPState: cannot open/create ... (Permission denied)" in
# logcat: the engine then keeps its state in memory and nothing is persisted.
allow mtk_hal_audio vendor_audio_data_file dir { search read write add_name remove_name create getattr }
allow mtk_hal_audio vendor_audio_data_file file { read write open create getattr setattr map unlink rename }
# Keep audioserver-hosted instances working too (older layouts / other devices).
allow audioserver vendor_audio_data_file dir { search read write add_name remove_name create getattr }
allow audioserver vendor_audio_data_file file { read write open create getattr setattr map unlink rename }
allow audioserver vendor_file file { read open getattr map execute }
