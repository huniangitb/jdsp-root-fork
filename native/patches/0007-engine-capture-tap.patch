 }
 
+/* 0007: capture tap wrapper.  The pre-effect input is taken before anything can
+ * write to the buffer (when AudioFlinger aliases in and out, the render below
+ * overwrites the input in place), the output lane right after the framework
+ * buffer has been produced - i.e. exactly the bytes AudioFlinger hands to the
+ * output thread, which makes the OUT lane directly comparable with the vendor
+ * AF35_EffectOut dump.  Both calls are no-ops when no tap is armed. */
+static int32_t generic_process_inner(effect_handle_t self, audio_buffer_t *in, audio_buffer_t *out);
+
 static int32_t generic_process(effect_handle_t self, audio_buffer_t *in, audio_buffer_t *out)
 {
 	struct effect_module_s *e = (struct effect_module_s *) self;
+	int32_t rc;
+	size_t frames = (in != NULL) ? in->frameCount : 0u;
+
+	if (e->tap != NULL && frames > 0u)
+		jdsp_tap_capture(e->tap, JDSP_TAP_LANE_IN, in->raw, frames);
+	rc = generic_process_inner(self, in, out);
+	if (e->tap != NULL && frames > 0u && out != NULL)
+		jdsp_tap_capture(e->tap, JDSP_TAP_LANE_OUT, out->raw, frames);
+	return rc;
+}
+
+static int32_t generic_process_inner(effect_handle_t self, audio_buffer_t *in, audio_buffer_t *out)
+{
+	struct effect_module_s *e = (struct effect_module_s *) self;
 	EffectDSPMain *fresh = __atomic_exchange_n(&e->pending, NULL, __ATOMIC_ACQUIRE);
 	if (fresh != NULL)
 	{
@@ -1759,6 +1786,56 @@
 static int32_t generic_command(effect_handle_t self, uint32_t cmdCode, uint32_t cmdSize, void *pCmdData, uint32_t *replySize, void *pReplyData)
 {
 	struct effect_module_s *e = (struct effect_module_s *) self;
+	/* 0007: capture tap control (see jdsp_tap.h).  The tap ids are diagnostic
+	 * only: never queued, never persisted, never part of the DSP parameter
+	 * shapes, and deliberately usable on a write-locked instance (jdpd unlocks
+	 * with the key; a capture must not need the key).  They are handled before
+	 * the gate and before the classifier, which rejects every unknown id. */
+	if ((cmdCode == EFFECT_CMD_SET_PARAM || cmdCode == EFFECT_CMD_GET_PARAM) &&
+		pCmdData != NULL && cmdSize >= 16u &&
+		*(const uint32_t *)((const uint8_t *)pCmdData + 4) == 4u)
+	{
+		int32_t tapId = (int32_t)*(const uint32_t *)((const uint8_t *)pCmdData + 12);
+		if (tapId == (int32_t)JDSP_TAP_PARAM_CONFIG || tapId == (int32_t)JDSP_TAP_PARAM_STATUS)
+		{
+			if (cmdCode == EFFECT_CMD_SET_PARAM && tapId == (int32_t)JDSP_TAP_PARAM_CONFIG)
+			{
+				const uint8_t *val = (const uint8_t *)pCmdData + 16;
+				uint32_t vsize = *(const uint32_t *)((const uint8_t *)pCmdData + 8);
+				int32_t *replyData = (int32_t *)pReplyData;
+				int rc = jdsp_tap_configure(&e->tap, val, vsize,
+					e->cur != NULL ? e->cur->formatFloatModeInt32Mode : 0,
+					e->cur != NULL ? (int)e->cur->mSamplingRate : 0);
+				if (replyData != NULL)
+					*replyData = rc;
+				return 0;
+			}
+			if (cmdCode == EFFECT_CMD_GET_PARAM && tapId == (int32_t)JDSP_TAP_PARAM_STATUS)
+			{
+				jdsp_tap_status_t st;
+				uint32_t need = (uint32_t)sizeof(jdsp_tap_status_t);
+				uint32_t total = 12u + 4u + need;
+				if (pReplyData != NULL && replySize != NULL && *replySize >= total)
+				{
+					memset(&st, 0, sizeof(st));
+					jdsp_tap_status(e->tap, &st);
+					if (e->tap == NULL)
+						st.magic = JDSP_TAP_MAGIC;
+					*(uint32_t *)((uint8_t *)pReplyData + 0) = 0u;
+					*(uint32_t *)((uint8_t *)pReplyData + 4) = 4u;
+					*(uint32_t *)((uint8_t *)pReplyData + 8) = need;
+					*(int32_t *)((uint8_t *)pReplyData + 12) = (int32_t)JDSP_TAP_PARAM_STATUS;
+					memcpy((uint8_t *)pReplyData + 16, &st, need);
+					*replySize = total;
+				}
+				else if (replySize != NULL)
+				{
+					*replySize = total;
+				}
+				return 0;
+			}
+		}
+	}
 	/* Caller write protection: while the instance is locked every parameter
 	 * write is refused here, before the engine (and the state recorder) ever
 	 * sees it.  An unlock handshake is consumed by the gate itself and never
@@ -1843,6 +1920,12 @@
 		/* JDSP_PARAM_CLASS_STREAM: fall through to the inline engine call. */
 	}
 	int32_t ret = EffectDSPMainCommand(e->cur, cmdCode, cmdSize, pCmdData, replySize, pReplyData);
+	/* 0007: keep the tap's frame geometry in sync with the format the framework
+	 * just configured (a format change stops the capture instead of writing
+	 * mis-framed data, see jdsp_tap_set_format). */
+	if (ret == 0 && cmdCode == EFFECT_CMD_SET_CONFIG && e->tap != NULL)
+		jdsp_tap_set_format(e->tap, e->cur->formatFloatModeInt32Mode,
+			(int)e->cur->mSamplingRate);
 	/* Persist every state changing command that the engine accepted. Recording is
 	 * disabled while a recorded sequence is being replayed, otherwise a replay
 	 * would duplicate its own records. */
@@ -1910,6 +1993,7 @@
 	/* Every fresh instance starts locked: only jdspd, presenting the engine key,
 	 * opens the write window (see jdsp_writelock.h). */
 	e->write_locked = 1;
+	e->tap = NULL;
 #ifdef DEBUG
 	LOGI("JamesDSP: Creating effect with %d sessionId", sessionId);
 #endif
@@ -1986,6 +2070,8 @@
 	jdsp_engine_free(e->cur);
 	e->cur = NULL;
