diff -ruN '--exclude=*.o' src-baseline/Main/libjamesdsp/jni/jamesdsp/jdsp_paramq.c src/Main/libjamesdsp/jni/jamesdsp/jdsp_paramq.c
--- src-baseline/Main/libjamesdsp/jni/jamesdsp/jdsp_paramq.c	1970-01-01 08:00:00.000000000 +0800
+++ src/Main/libjamesdsp/jni/jamesdsp/jdsp_paramq.c	2026-10-25 14:53:24.425123902 +0800
@@ -0,0 +1,239 @@
+/*
+ * jdsp_paramq.c - deferred SET_PARAM application for the JamesDSP effect
+ * library.  See jdsp_paramq.h for the design and the rationale.
+ */
+#include "jdsp_paramq.h"
+
+#include <stdlib.h>
+#include <string.h>
+
+/* Parameter id table, mirrored from the SET_PARAM branches of
+ * EffectDSPMainCommand() (jamesdsp.c).  vsize is the exact value size that
+ * handler expects; 0 marks the one variable sized parameter (PEQ cascade,
+ * 1300).  A compile time guarantee that the mirrored set stays in sync with
+ * the handler is not possible without refactoring the handler itself, so the
+ * host test test_paramq.c cross-checks this table against the classification
+ * of every id the handler can consume. */
+typedef struct
+{
+	int32_t id;
+	uint32_t vsize; /* exact value size, 0 = variable (PEQ 1300) */
+	int cls;        /* JDSP_PARAM_CLASS_* */
+} jdsp_param_shape_t;
+
+static const jdsp_param_shape_t jdsp_param_shapes[] = {
+	/* Value parameters: every write fully replaces the previous value of the
+	 * same id, so a queued duplicate can be merged and a burst of slider
+	 * updates collapses into one apply per buffer. */
+	{112, 2, JDSP_PARAM_CLASS_VALUE},    /* bass boost max gain */
+	{115, 68, JDSP_PARAM_CLASS_VALUE},   /* compander shape */
+	{116, 128, JDSP_PARAM_CLASS_VALUE},  /* multimodal equalizer axis */
+	{128, 2, JDSP_PARAM_CLASS_VALUE},    /* reverb mode */
+	{137, 2, JDSP_PARAM_CLASS_VALUE},    /* stereo enhancement */
+	{150, 2, JDSP_PARAM_CLASS_VALUE},    /* vacuum tube drive */
+	{188, 2, JDSP_PARAM_CLASS_VALUE},    /* crossfeed mode */
+	{1200, 2, JDSP_PARAM_CLASS_VALUE},   /* compressor enable */
+	{1201, 2, JDSP_PARAM_CLASS_VALUE},   /* bass boost enable */
+	{1202, 2, JDSP_PARAM_CLASS_VALUE},   /* equalizer enable */
+	{1203, 2, JDSP_PARAM_CLASS_VALUE},   /* reverb enable */
+	{1204, 2, JDSP_PARAM_CLASS_VALUE},   /* stereo widen enable */
+	{1205, 2, JDSP_PARAM_CLASS_VALUE},   /* convolver enable */
+	{1206, 2, JDSP_PARAM_CLASS_VALUE},   /* analogue model enable */
+	{1208, 2, JDSP_PARAM_CLASS_VALUE},   /* crossfeed enable */
+	{1210, 2, JDSP_PARAM_CLASS_VALUE},   /* arbitrary response eq enable */
+	{1212, 2, JDSP_PARAM_CLASS_VALUE},   /* viper ddc enable */
+	{1213, 2, JDSP_PARAM_CLASS_VALUE},   /* liveprog enable */
+	{1214, 2, JDSP_PARAM_CLASS_VALUE},   /* PEQ enable */
+	{1215, 2, JDSP_PARAM_CLASS_VALUE},   /* loudness enable */
+	{1216, 2, JDSP_PARAM_CLASS_VALUE},   /* harmonic expander enable */
+	{1217, 2, JDSP_PARAM_CLASS_VALUE},   /* sub harmonic expander enable */
+	{1218, 2, JDSP_PARAM_CLASS_VALUE},   /* NOS R2R enable */
+	{1300, 0, JDSP_PARAM_CLASS_VALUE},   /* PEQ cascade (variable 8..1288) */
+	{1301, 20, JDSP_PARAM_CLASS_VALUE},  /* loudness config */
+	{1302, 4, JDSP_PARAM_CLASS_VALUE},   /* loudness volume */
+	{1305, 44, JDSP_PARAM_CLASS_VALUE},  /* harmonic expander config */
+	{1306, 44, JDSP_PARAM_CLASS_VALUE},  /* sub harmonic expander config */
+	{1307, 44, JDSP_PARAM_CLASS_VALUE},  /* NOS R2R config */
+	{1500, 12, JDSP_PARAM_CLASS_VALUE},  /* limiter threshold/release/postgain */
+	{25000, 4, JDSP_PARAM_CLASS_VALUE},  /* ArbEq hash slot */
+	{25001, 4, JDSP_PARAM_CLASS_VALUE},  /* DDC hash slot */
+	{25002, 4, JDSP_PARAM_CLASS_VALUE},  /* LiveProg hash slot */
+	{25003, 4, JDSP_PARAM_CLASS_VALUE},  /* convolver app hash slot */
+	/* Chunked transfers: the alloc/chunk/done sequence must stay complete and
+	 * ordered, and the done commands do heavy work (impulse FFT reload,
+	 * string parsers) that must not run on the render thread.  These stay on
+	 * the command path exactly as before. */
+	{8888, 8, JDSP_PARAM_CLASS_STREAM},      /* string buffer alloc */
+	{9999, 16, JDSP_PARAM_CLASS_STREAM},     /* impulse header */
+	{12000, 16384, JDSP_PARAM_CLASS_STREAM}, /* impulse chunk */
+	{12001, 256, JDSP_PARAM_CLASS_STREAM},   /* string chunk */
+	{10004, 2, JDSP_PARAM_CLASS_STREAM},     /* impulse done (convolver load) */
+	{10006, 2, JDSP_PARAM_CLASS_STREAM},     /* ArbEq string done */
+	{10009, 2, JDSP_PARAM_CLASS_STREAM},     /* DDC string done */
+	{10010, 2, JDSP_PARAM_CLASS_STREAM},     /* EEL string done */
+};
+
+#define JDSP_PARAM_SHAPE_COUNT (sizeof(jdsp_param_shapes) / sizeof(jdsp_param_shapes[0]))
+
+static uint32_t jdsp_paramq_get_u32(const uint8_t *p)
+{
+	return (uint32_t)p[0] | ((uint32_t)p[1] << 8) | ((uint32_t)p[2] << 16) |
+	       ((uint32_t)p[3] << 24);
+}
+
+int jdsp_param_classify(const void *cmd_data, uint32_t cmd_size, int32_t *id_out)
+{
+	const uint8_t *d = (const uint8_t *)cmd_data;
+	uint32_t psize, vsize, id;
+	size_t i;
+
+	if (d == NULL || cmd_size < 16u)
+		return JDSP_PARAM_CLASS_INVALID;
+	psize = jdsp_paramq_get_u32(d + 4);
+	vsize = jdsp_paramq_get_u32(d + 8);
+	if (psize != 4u || vsize == 0u)
+		return JDSP_PARAM_CLASS_INVALID;
+	/* The engine handler trusts the framework not to truncate commands; the
+	 * queue copies the bytes, so it has to verify the bound itself. */
+	if (vsize > cmd_size - 16u)
+		return JDSP_PARAM_CLASS_INVALID;
+	id = jdsp_paramq_get_u32(d + 12);
+	if (id_out != NULL)
+		*id_out = (int32_t)id;
+
+	for (i = 0; i < JDSP_PARAM_SHAPE_COUNT; i++)
+	{
+		const jdsp_param_shape_t *s = &jdsp_param_shapes[i];
+		if (s->id != (int32_t)id)
+			continue;
+		if (s->vsize == 0u)
+		{
+			/* PEQ cascade: 2 header floats + N * 5 band floats,
+			 * 8..1288 bytes (PEQ_MAX_BANDS = 64), multiple of 4. */
+			if (vsize >= 8u && vsize <= 1288u && (vsize & 3u) == 0u)
+				return s->cls;
+			return JDSP_PARAM_CLASS_INVALID;
+		}
+		if (vsize == s->vsize)
+			return s->cls;
+		return JDSP_PARAM_CLASS_INVALID;
+	}
+	/* Unknown parameter id (includes the write-lock handshake 0x7A00, which
+	 * the gate consumes before this point when the lock is enabled): the
+	 * engine handler returned -1 for these before deferral, keep that. */
+	return JDSP_PARAM_CLASS_INVALID;
+}
+
+void jdsp_paramq_init(jdsp_paramq_t *q)
+{
+	if (q == NULL)
+		return;
+	memset(q, 0, sizeof(*q));
+	pthread_mutex_init(&q->lock, NULL);
+}
+
+void jdsp_paramq_destroy(jdsp_paramq_t *q)
+{
+	int i;
+	if (q == NULL)
+		return;
+	pthread_mutex_lock(&q->lock);
+	for (i = 0; i < JDSP_PARAMQ_CAPACITY; i++)
+	{
+		free(q->slot[i].data);
+		q->slot[i].data = NULL;
+	}
+	q->head = 0;
+	q->count = 0;
+	pthread_mutex_unlock(&q->lock);
+	pthread_mutex_destroy(&q->lock);
+}
+
+int jdsp_paramq_push(jdsp_paramq_t *q, int32_t id, uint32_t size, uint8_t *data,
+                     int mergeable)
+{
+	int ret = 0;
+
+	if (q == NULL || data == NULL || size == 0u)
+	{
+		free(data);
+		return -1;
+	}
+
+	pthread_mutex_lock(&q->lock);
+	if (mergeable)
+	{
+		int i;
+		for (i = 0; i < q->count; i++)
+		{
+			int idx = (q->head + i) % JDSP_PARAMQ_CAPACITY;
+			if (q->slot[idx].id == id)
+			{
+				/* Same parameter already queued: replace it in place.  The
+				 * position is kept so unrelated parameters still apply in
+				 * arrival order; the audio thread then applies only the
+				 * latest value of this parameter. */
+				free(q->slot[idx].data);
+				q->slot[idx].data = data;
+				q->slot[idx].size = size;
+				pthread_mutex_unlock(&q->lock);
+				return 0;
+			}
+		}
+	}
+	if (q->count >= JDSP_PARAMQ_CAPACITY)
+	{
+		/* Full: drop the oldest entry (counted).  Mergeable ids rarely get
+		 * here - a slider storm merges into one slot - but a stream of more
+		 * distinct parameters than the capacity can hold must not corrupt
+		 * the queue. */
+		free(q->slot[q->head].data);
+		q->slot[q->head].data = NULL;
+		q->head = (q->head + 1) % JDSP_PARAMQ_CAPACITY;
+		q->count--;
+		q->dropped++;
+		ret = 1;
+	}
+	q->slot[(q->head + q->count) % JDSP_PARAMQ_CAPACITY].id = id;
+	q->slot[(q->head + q->count) % JDSP_PARAMQ_CAPACITY].size = size;
+	q->slot[(q->head + q->count) % JDSP_PARAMQ_CAPACITY].data = data;
+	q->count++;
+	pthread_mutex_unlock(&q->lock);
+	return ret;
+}
+
+void jdsp_paramq_drain(jdsp_paramq_t *q, void *engine,
+                       void (*apply)(void *engine, uint32_t size, const uint8_t *data))
+{
+	jdsp_paramq_entry_t local[JDSP_PARAMQ_CAPACITY];
+	int n = 0;
+	int i;
+
+	if (q == NULL || apply == NULL)
+		return;
+
+	/* Swap the queue contents out under the lock (a couple of pointer stores
+	 * per entry), then run the apply callbacks without holding it: the
+	 * setters can be expensive, and a concurrent command thread must still be
+	 * able to enqueue while they run. */
+	pthread_mutex_lock(&q->lock);
+	if (q->count > 0)
+	{
+		for (i = 0; i < q->count; i++)
+		{
+			int idx = (q->head + i) % JDSP_PARAMQ_CAPACITY;
+			local[i] = q->slot[idx];
+			q->slot[idx].data = NULL;
+		}
+		n = q->count;
+		q->count = 0;
+		q->head = 0;
+	}
+	pthread_mutex_unlock(&q->lock);
+
+	for (i = 0; i < n; i++)
+	{
+		apply(engine, local[i].size, local[i].data);
+		free(local[i].data);
+	}
+}
