+/*
+ * jdsp_paramq.h - deferred SET_PARAM application for the JamesDSP effect library.
+ *
+ * Problem this solves: generic_command() runs on a binder thread of the audio
+ * HAL while generic_process() renders on the audio callback thread.  Applying
+ * a SET_PARAM in place from the command thread mutates engine state (EQ
+ * coefficient arrays, gains, ...) element by element while the render thread
+ * reads the same state - a data race that produces short bursts of wrong
+ * samples (audible noise) even though nothing underruns.  Slider drags push
+ * 30-100 such writes per second.
+ *
+ * Fix: the command thread no longer applies value parameters at all.  It
+ * validates the command shape, copies it into a small per-instance queue and
+ * answers success immediately; generic_process() drains the queue at the start
+ * of every buffer, on the audio thread, before any rendering - at that point
+ * there is no concurrent reader, so the existing setters are safe to call.
+ * While a value sits in the queue, a newer write of the same parameter id
+ * replaces it (merge), which bounds the queue under slider storms and lets the
+ * audio thread apply at most one value per parameter per buffer.
+ *
+ * What is NOT deferred (stays inline on the command thread, exactly as before):
+ *   - chunked transfers (impulse/string alloc, chunks, done): rare, heavy, and
+ *     they must not be merged or evicted, so they never enter the queue;
+ *   - EFFECT_CMD_ENABLE/DISABLE (a single flag store, sent by AudioFlinger);
+ *   - EFFECT_CMD_GET_PARAM and the health/hash queries (synchronous replies);
+ *   - the write-lock handshake 0x7A00 (consumed by jdsp_writelock_gate before
+ *     this module ever sees it; it classifies as invalid here, so a build with
+ *     the write lock compiled out still never queues or records it).
+ *
+ * Persisted-state interaction (jdsp_state): a queued value parameter is
+ * recorded to the state store at enqueue time - the state file therefore
+ * contains the command even if the process dies before the audio thread
+ * applied it, and replays (new instances, engine rebuilds) keep working
+ * unchanged.
+ *
+ * Host tests: test/run_tests.sh compiles this file standalone (no engine
+ * dependency).
+ */
+
+#ifndef JDSP_PARAMQ_H
+#define JDSP_PARAMQ_H
+
+#include <pthread.h>
+#include <stddef.h>
+#include <stdint.h>
+
+/* Queue depth.  One render callback at 48 kHz / 1024 frames is ~21 ms; even a
+ * 100 Hz slider storm produces ~2 updates per callback.  The burst case (an
+ * applyAll pushes ~30 distinct parameters at once) fits with headroom; beyond
+ * that the oldest entry is dropped (counted, see jdsp_paramq_t::dropped). */
+#ifndef JDSP_PARAMQ_CAPACITY
+#define JDSP_PARAMQ_CAPACITY 64
+#endif
+
+/* jdsp_param_classify() results. */
+#define JDSP_PARAM_CLASS_INVALID 0 /* malformed or unknown parameter id */
+#define JDSP_PARAM_CLASS_VALUE   1 /* value parameter: defer, mergeable by id */
+#define JDSP_PARAM_CLASS_STREAM  2 /* chunked transfer: apply inline, never merge */
+
+typedef struct
+{
+	int32_t id;      /* SET_PARAM parameter id (effect_param_t::data[0..3]) */
+	uint32_t size;   /* command bytes (effect_param_t header + payload) */
+	uint8_t *data;   /* malloc()'d copy of the command */
+} jdsp_paramq_entry_t;
+
+typedef struct
+{
+	pthread_mutex_t lock; /* short critical sections only (pointer swaps) */
+	jdsp_paramq_entry_t slot[JDSP_PARAMQ_CAPACITY];
+	int head;             /* index of the oldest entry */
+	int count;            /* number of queued entries */
+	unsigned long long dropped; /* entries evicted because the queue was full */
+} jdsp_paramq_t;
+
+/* Initialize / tear down.  destroy() frees any still queued entries. */
+void jdsp_paramq_init(jdsp_paramq_t *q);
+void jdsp_paramq_destroy(jdsp_paramq_t *q);
+
+/* Queue one command.  data must be malloc()'d; ownership transfers to the
+ * queue on any return value (including failure).  When mergeable is non-zero
+ * and an entry with the same id is already queued, that entry is replaced in
+ * place (position preserved).  When the queue is full the oldest entry is
+ * evicted (dropped++).  Returns 0 normally, 1 when an entry had to be evicted,
+ * -1 on argument error. */
+int jdsp_paramq_push(jdsp_paramq_t *q, int32_t id, uint32_t size, uint8_t *data,
+                     int mergeable);
+
+/* Take every queued entry and apply it in order via apply(engine, size, data),
+ * then free it.  Runs the apply callbacks outside the queue lock.  Designed to
+ * be called from the render thread at a buffer boundary. */
+void jdsp_paramq_drain(jdsp_paramq_t *q, void *engine,
+                       void (*apply)(void *engine, uint32_t size, const uint8_t *data));
+
+/* Validate and classify a SET_PARAM command payload.
+ *
+ * A command is well formed when cmd_data holds at least an effect_param_t
+ * header (16 bytes: status, psize, vsize, first parameter word), psize == 4,
+ * vsize > 0, cmd_size covers the announced payload (16 + vsize) and the
+ * parameter id is one the engine's command handler knows, with the value size
+ * that handler expects.  Everything else classifies as INVALID - which is what
+ * the engine handler returned (-1) for such commands before deferral existed,
+ * so reply semantics and state recording behaviour are unchanged.
+ *
+ * Returns JDSP_PARAM_CLASS_*; on any result other than INVALID, *id_out (when
+ * non-NULL) receives the parameter id. */
+int jdsp_param_classify(const void *cmd_data, uint32_t cmd_size, int32_t *id_out);
+
+#endif /* JDSP_PARAMQ_H */
