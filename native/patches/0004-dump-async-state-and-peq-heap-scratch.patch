 /* ------------------------------------------------------------------------- */
+/* debounced writer thread (0004)                                             */
+/* ------------------------------------------------------------------------- */
+
+/* Before 0004 every recorded parameter synchronously serialised the whole
+ * store (state.bin is ~64 KB), wrote it, and renamed it - all under g_lock,
+ * on the binder thread that delivered the SET_PARAM.  With the file at ~64 KB
+ * that path measured p95 ~48 ms, right on the caller's latency budget.
+ *
+ * Now record() only marks the store dirty and signals this thread; the
+ * serialisation happens under g_lock (cheap: one memcpy of the records into a
+ * private buffer) but the write+rename runs here, outside every lock.  A burst
+ * of slider updates therefore collapses into one file write.
+ *
+ * Trade-offs (deliberate):
+ *   - a crash can lose the newest ~250 ms of records (the coalescing window
+ *     plus one IO); the file itself is always a complete, CRC-valid snapshot;
+ *   - process exit is covered: jdsp_state_shutdown() joins this thread and
+ *     then runs one forced (fsync) flush of whatever is still dirty.  There is
+ *     nothing per-instance to flush: the store is process-global, so engine
+ *     teardown (EffectRelease) never loses records either.
+ *   - the realtime path (enqueue -> audio-thread drain) never touches this
+ *     thread: record() got strictly cheaper (no serialize, no IO).
+ */
+static struct {
+    int started;
+    int stop;
+    pthread_t tid;
+} wr = {
+    .started = 0,
+    .stop = 0,
+};
