+
+static void state_writer_stop(void)
+{
+    if (!wr.started)
+        return;
+    pthread_mutex_lock(&g_lock);
+    wr.stop = 1;
+    pthread_cond_signal(&g_save_cond);
+    pthread_mutex_unlock(&g_lock);
+    pthread_join(wr.tid, NULL);
+    wr.started = 0;
+    wr.stop = 0;
+}
