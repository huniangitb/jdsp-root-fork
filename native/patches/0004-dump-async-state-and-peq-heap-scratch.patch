+static void state_writer_start(void)
+{
+    pthread_t tid;
+    if (wr.started || wr.stop)
+        return;
+    if (pthread_create(&tid, NULL, state_writer_thread, NULL) != 0)
+        return; /* save-on-flush only; record still works */
+    wr.tid = tid;
+    wr.started = 1;
