+++ b/Main/libjamesdsp/jni/jamesdsp/jdsp_accum.c
@@ -0,0 +1,84 @@
+/*
+ * jdsp_accum.c - ACCESS_ACCUMULATE support for the JamesDSP effect library.
+ *
+ * Why this exists (0005): when AudioFlinger mounts a session effect whose
+ * input and output buffers differ (a per-session chain whose output buffer
+ * maps the output thread's shared mix), it configures the effect with
+ * EFFECT_BUFFER_ACCESS_ACCUMULATE.  The contract (frameworks/av
+ * services/audioflinger Effects.h, EffectModule::requiredEffectBufferAccessMode)
+ * is that the effect ADDS its rendered output to the existing content of the
+ * output buffer, because that buffer already carries the contribution of the
+ * other tracks and effect chains of the thread.
+ *
+ * Every process path of this engine used to write its output with plain
+ * stores.  On stock AudioFlinger where the chain output buffer aliases the
+ * chain input buffer that went unnoticed (replace == in-place transform), but
+ * on ROMs that give the effect a real output mapping (measured: MTK HyperOS
+ * Android 15, "Out(0x...) -> <main mix>") the store wiped the shared mix:
+ * one enabled JamesDSP instance on any session - even on a session whose
+ * track delivers pure digital silence - muted the whole output thread, and
+ * with several instances only the last processed chain stayed audible.
+ */
+#include "jdsp_accum.h"
+
+#include <stdint.h>
+
+static int32_t clamp_i32(int64_t v)
+{
+	if (v > INT32_MAX)
+		return INT32_MAX;
+	if (v < INT32_MIN)
+		return INT32_MIN;
+	return (int32_t)v;
+}
+
+int jdsp_accum_add(void *dst, const void *src, size_t frames, int mode)
+{
+	size_t i;
+	size_t n;
+
+	if (dst == NULL || src == NULL || frames == 0)
+		return -1;
+
+	/* stereo interleaved */
+	n = frames * 2u;
+
+	switch (mode)
+	{
+	case JDSP_ACCUM_MODE_INT16:
+		{
+			int16_t *d = (int16_t *)dst;
+			const int16_t *s = (const int16_t *)src;
+			for (i = 0; i < n; i++)
+			{
+				int32_t v = (int32_t)d[i] + (int32_t)s[i];
+				if (v > 32767)
+					v = 32767;
+				else if (v < -32768)
+					v = -32768;
+				d[i] = (int16_t)v;
+			}
+		}
+		break;
+	case JDSP_ACCUM_MODE_FLOAT:
+		{
+			float *d = (float *)dst;
+			const float *s = (const float *)src;
+			for (i = 0; i < n; i++)
+				d[i] += s[i];
+		}
+		break;
+	case JDSP_ACCUM_MODE_INT32:
+	case JDSP_ACCUM_MODE_INT8_24:
+		{
+			int32_t *d = (int32_t *)dst;
+			const int32_t *s = (const int32_t *)src;
+			for (i = 0; i < n; i++)
+				d[i] = clamp_i32((int64_t)d[i] + (int64_t)s[i]);
+		}
+		break;
+	default: /* packed 24 bit: not supported, caller keeps replace behaviour */
+		return -1;
+	}
+	return 0;
+}
--- /dev/null
+++ b/Main/libjamesdsp/jni/jamesdsp/jdsp_accum.h
@@ -0,0 +1,37 @@
+/*
+ * jdsp_accum.h - ACCESS_ACCUMULATE support for the JamesDSP effect library.
+ *
+ * See jdsp_accum.c for the rationale; 0005-engine-accumulate-out.patch is the
+ * complete story.
+ */
+#ifndef JDSP_ACCUM_H
+#define JDSP_ACCUM_H
+
+#include <stddef.h>
+
+/*
+ * Mode constants mirror the formatFloatModeInt32Mode encoding used by
+ * jamesdsp.c's process dispatch (derived from the SET_CONFIG format):
+ *   0 = int16 stereo interleaved
+ *   1 = float32 stereo interleaved
+ *   2 = int32 stereo interleaved (32 bit)
+ *   3 = packed 24 bit (not supported by the accumulator)
+ *   4 = int8_24 stereo interleaved (24 bit payload in the high bits of an
+ *       int32, same width as mode 2)
+ */
+#define JDSP_ACCUM_MODE_INT16    0
+#define JDSP_ACCUM_MODE_FLOAT    1
+#define JDSP_ACCUM_MODE_INT32    2
+#define JDSP_ACCUM_MODE_PACKED24 3
+#define JDSP_ACCUM_MODE_INT8_24  4
+
+/*
+ * Adds `frames` stereo interleaved frames of `src` (the freshly rendered
+ * effect output) into `dst` (the buffer the framework handed to the effect as
+ * its output), saturating for the integer formats.  Returns 0 on success and
+ * -1 when `mode` is not supported (the caller must then keep its historical
+ * replace behaviour).
+ */
+int jdsp_accum_add(void *dst, const void *src, size_t frames, int mode);
+
+#endif /* JDSP_ACCUM_H */
