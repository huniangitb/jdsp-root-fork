+/* 0005: framework entry.  When the framework configured this instance with
+ * EFFECT_BUFFER_ACCESS_ACCUMULATE (it does that whenever the effect's input
+ * and output buffers differ - for a per-session chain the output buffer maps
+ * the output thread's shared mix, which already carries the contribution of
+ * the other tracks and chains), the rendered output must be ADDED to the out
+ * buffer.  Every render path of this engine stores its samples instead,
+ * which on such ROMs wipes the shared mix: a single enabled instance mounted
+ * on a session whose track delivers pure silence zeroed the whole output
+ * thread ("threadLoop_write write muted data to hw"), and with several
+ * mounted instances only the last processed chain stayed audible.
+ *
+ * The render therefore goes into a private scratch buffer first and is added
+ * to the out buffer afterwards (saturating for the integer formats).  When
+ * the buffers alias, or the framework asked for plain ACCESS_WRITE, or the
+ * scratch cannot be provided, the historical replace behaviour is kept - it
+ * is the correct contract for an aliased in/out pair.  Packed 24 bit has no
+ * accumulator and keeps the historical behaviour (a format no HAL here uses
+ * for effect chains). */
+int32_t EffectDSPMainProcess(EffectDSPMain *dspmain, audio_buffer_t *in, audio_buffer_t *out)
+{
+	size_t frames = in->frameCount;
+	int accumulate = dspmain->outAccumulate && frames > 0u && out->raw != in->raw
+		&& dspmain->formatFloatModeInt32Mode != JDSP_ACCUM_MODE_PACKED24;
+	audio_buffer_t renderBuf;
+
+	if (accumulate)
+	{
+		size_t needBytes = frames * 2u * sizeof(int32_t);
+		if (dspmain->accScratch == NULL || dspmain->accScratchFrames < frames)
+		{
+			size_t wantBytes = dspmain->accScratchFrames * 2u * sizeof(int32_t);
+			void *grown;
+			if (wantBytes < needBytes)
+				wantBytes = needBytes;
+			grown = realloc(dspmain->accScratch, wantBytes);
+			if (grown != NULL)
+			{
+				dspmain->accScratch = grown;
+				dspmain->accScratchFrames = wantBytes / (2u * sizeof(int32_t));
+			}
+			else
+			{
+				accumulate = 0; /* OOM: keep the historical replace behaviour */
+			}
+		}
+	}
+	if (accumulate)
+	{
+		renderBuf = *out;
+		renderBuf.raw = dspmain->accScratch;
+		renderBuf.frameCount = frames;
+		EffectDSPMainRender(dspmain, in, &renderBuf);
+		if (jdsp_accum_add(out->raw, dspmain->accScratch, frames,
+			dspmain->formatFloatModeInt32Mode) != 0)
+		{
+			/* unreachable for the modes accepted above; replace is the only
+			 * possible fallback and matches the historical behaviour */
+		}
+		return 0;
+	}
+	return EffectDSPMainRender(dspmain, in, out);
+}
