+/* 0006: raw passthrough for a *pristine* instance (see EffectCreate).  Mirrors the
+ * accumulate structure of EffectDSPMainProcess but copies the input instead of
+ * rendering it, so an instance whose engine has not been built yet contributes
+ * exactly its own track to the mix (or passes it through unchanged for the
+ * aliased/replace case) instead of running a zeroed DSP. */
+static size_t jdsp_frame_bytes(int mode)
+{
+	switch (mode)
+	{
+	case 0:  return 2u * 2u;       /* int16 stereo */
+	case 1:  return 4u * 2u;       /* float */
+	case 2:  return 4u * 2u;       /* int32 */
+	case 3:  return 3u * 2u;       /* packed 24 bit */
+	case 4:  return 4u * 2u;       /* 8.24 */
+	default: return 2u * 2u;
+	}
+}
+
+static void jdsp_copy_interleaved(const void *src, void *dst, size_t frames, int mode)
+{
+	memcpy(dst, src, frames * jdsp_frame_bytes(mode));
+}
+
+static int32_t jdsp_passthrough(EffectDSPMain *dspmain, audio_buffer_t *in, audio_buffer_t *out)
+{
+	size_t frames = in->frameCount;
+	int mode = dspmain->formatFloatModeInt32Mode;
+	int accumulate = dspmain->outAccumulate && frames > 0u && out->raw != in->raw
+		&& mode != JDSP_ACCUM_MODE_PACKED24;
+	if (accumulate)
+	{
+		size_t needBytes = frames * 2u * sizeof(int32_t);
+		if (dspmain->accScratch == NULL || dspmain->accScratchFrames < frames)
+		{
+			size_t wantBytes = dspmain->accScratchFrames * 2u * sizeof(int32_t);
+			void *grown;
+			if (wantBytes < needBytes)
+				wantBytes = needBytes;
+			grown = realloc(dspmain->accScratch, wantBytes);
+			if (grown != NULL)
+			{
+				dspmain->accScratch = grown;
+				dspmain->accScratchFrames = wantBytes / (2u * sizeof(int32_t));
+			}
+			else
+			{
+				accumulate = 0;
+			}
+		}
+	}
+	if (accumulate)
+	{
+		jdsp_copy_interleaved(in->raw, dspmain->accScratch, frames, mode);
+		return jdsp_accum_add(out->raw, dspmain->accScratch, frames, mode);
+	}
+	if (out->raw != in->raw)
+		jdsp_copy_interleaved(in->raw, out->raw, frames, mode);
+	return 0;
+}
