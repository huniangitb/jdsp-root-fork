+/* One live effect instance.
+ *
+ * The engine object is not mutated in place when the persisted parameters
+ * change: the builder thread (see below) constructs a *complete* second engine,
+ * applies every recorded command to it there, and only then publishes it in
+ * `pending`.  The render thread swaps `cur` for `pending` at a buffer boundary,
+ * which costs a pointer store.  Consequences:
+ *   - the render callback never applies parameters, so a big impulse/EEL upload
+ *     can no longer overrun a buffer;
+ *   - the engine is always in a fully applied state, never half updated;
+ *   - the previous engine is handed to the builder and destroyed there. */
 struct effect_module_s
 {
 	const struct effect_interface_s *itfe;
-	EffectDSPMain effect;
+	EffectDSPMain *cur;       /* engine the render thread is using */
+	EffectDSPMain *pending;   /* fully prepared replacement (atomic) */
+	uint64_t cur_gen;         /* store generation cur was built from */
+	float built_fs;           /* sample rate cur was built for */
+	struct effect_module_s *next;
 	effect_descriptor_t *descriptor;
+	/* Crossfade scratch: on a swap the previous engine renders one buffer here so
+	 * the two engines can be mixed, which hides the filter/convolver history
+	 * reset.  Allocated once per instance, never on the render path. */
+	void *xscratch;
+	size_t xscratch_bytes;
 };
+
+#define JDSP_XFADE_MAX_FRAMES 8192
