+/* Engines retired by the render thread, destroyed by the builder.  The list is
+ * guarded by a plain mutex that is only ever held for a push or a splice, so a
+ * render thread can never wait on engine teardown. */
+static pthread_mutex_t g_retire_lock = PTHREAD_MUTEX_INITIALIZER;
+static EffectDSPMain *g_retired;
+
+/* Live instances, guarded by g_inst_lock.  The builder holds it while it builds,
+ * which is what keeps EffectRelease from freeing an instance mid-build. */
+static pthread_mutex_t g_inst_lock = PTHREAD_MUTEX_INITIALIZER;
+static struct effect_module_s *g_insts;
+static pthread_t g_builder_tid;
+static int g_builder_started;
+static int g_builder_stop;
+static uint64_t g_last_gen; /* last generation seen, for burst debouncing */
+
+static EffectDSPMain *jdsp_engine_new(const EffectDSPMain *like)
+{
+	EffectDSPMain *eng = (EffectDSPMain *)calloc(1, sizeof(*eng));
+	if (eng == NULL)
+		return NULL;
+	EffectDSPMainConstructor(eng);
+	/* Inherit the stream format the instance is currently running at, so the
+	 * recorded commands are applied with the right sample rate (PEQ/loudness
+	 * coefficients depend on it). */
+	if (like != NULL)
+	{
+		eng->mSamplingRate = like->mSamplingRate;
+		eng->formatFloatModeInt32Mode = like->formatFloatModeInt32Mode;
+		if (like->mSamplingRate > 0.0f)
+			JamesDSPSetSampleRate(&eng->jdsp, like->mSamplingRate, 0);
+	}
+	return eng;
+}
+
+static void jdsp_engine_free(EffectDSPMain *eng)
+{
+	if (eng == NULL)
+		return;
+	EffectDSPMainDestructor(eng);
+	free(eng);
+}
+
+/* Hand an engine that the render thread just replaced over to the builder.  The
+ * critical section is two pointer stores, so the audio thread can never wait on
+ * engine teardown (which happens outside the lock). */
+static void jdsp_retire_push(EffectDSPMain *eng)
+{
+	pthread_mutex_lock(&g_retire_lock);
+	eng->retireNext = g_retired;
+	g_retired = eng;
+	pthread_mutex_unlock(&g_retire_lock);
+}
+
+static void *jdsp_builder_thread(void *arg)
+{
+	(void)arg;
+	for (;;)
+	{
+		struct effect_module_s *inst;
+		EffectDSPMain *dead;
+		uint64_t gen;
+		int stop;
+
+		/* 20 ms: the poll itself is one atomic load, and the render thread only
+		 * swaps when a fully built engine shows up, so this interval bounds the
+		 * latency without ever touching audio timing. */
+		usleep(20000);
+
+		pthread_mutex_lock(&g_inst_lock);
+		stop = g_builder_stop;
+		pthread_mutex_unlock(&g_inst_lock);
+		if (stop)
+			break;
+
+		/* Destroy retired engines outside every lock. */
+		pthread_mutex_lock(&g_retire_lock);
+		dead = g_retired;
+		g_retired = NULL;
+		pthread_mutex_unlock(&g_retire_lock);
+		while (dead != NULL)
+		{
+			EffectDSPMain *next = (EffectDSPMain *)dead->retireNext;
+			jdsp_engine_free(dead);
+			dead = next;
+		}
+
+		gen = jdsp_state_generation();
+		/* Debounce: an App start pushes ~30 parameters in a burst, each of which
+		 * bumps the generation.  Rebuilding once per burst instead of once per
+		 * parameter keeps this thread cheap; the extra tick costs 20 ms. */
+		if (gen != g_last_gen)
+		{
+			g_last_gen = gen;
+			continue;
+		}
+
+		pthread_mutex_lock(&g_inst_lock);
+		for (inst = g_insts; inst != NULL; inst = inst->next)
+		{
+			EffectDSPMain *fresh;
+			int stale;
+
+			if (__atomic_load_n(&inst->pending, __ATOMIC_ACQUIRE) != NULL)
+				continue; /* the render thread has not picked the last one up yet */
+
+			stale = (inst->cur_gen != gen) ||
+			        (inst->cur != NULL && inst->cur->mSamplingRate != inst->built_fs);
+			if (!stale)
+				continue;
+
+			fresh = jdsp_engine_new(inst->cur);
+			if (fresh == NULL)
+				continue;
+			/* Full apply, on this thread: the render callback never sees a
+			 * partially configured engine. */
+			jdsp_state_replay(fresh, jdsp_state_dispatch);
+			inst->built_fs = fresh->mSamplingRate;
+			inst->cur_gen = gen;
+			__atomic_store_n(&inst->pending, fresh, __ATOMIC_RELEASE);
+		}
+		pthread_mutex_unlock(&g_inst_lock);
+	}
+	return NULL;
+}
+
+static void jdsp_builder_start(void)
+{
+	pthread_t tid;
+	if (g_builder_started)
+		return;
+	if (pthread_create(&tid, NULL, jdsp_builder_thread, NULL) != 0)
+		return;
+	g_builder_tid = tid;
+	g_builder_started = 1;
+}
+
+static void jdsp_builder_stop(void)
+{
+	if (!g_builder_started)
+		return;
+	g_builder_stop = 1;
+	(void)pthread_join(g_builder_tid, NULL);
+	g_builder_started = 0;
+}
+/* Linear crossfade from the previous engine's output (src) to the new engine's
+ * output (dst), over exactly one buffer.  Both buffers use the instance's current
+ * sample format.  Unknown/unsupported formats keep the new output unchanged. */
+static void jdsp_crossfade(audio_buffer_t *dst, const audio_buffer_t *src, size_t frames,
+                           int mode)
+{
+	size_t total = frames * 2u;
+	size_t i;
+	if (frames == 0u)
+		return;
+	switch (mode)
+	{
+	case 0: /* int16 */
+		for (i = 0; i < total; i++)
+		{
+			float t = (float)i / (float)(total - 1u ? total - 1u : 1u);
+			dst->s16[i] = (int16_t)((float)src->s16[i] * (1.0f - t) + (float)dst->s16[i] * t);
+		}
+		break;
+	case 1: /* float */
+		for (i = 0; i < total; i++)
+		{
+			float t = (float)i / (float)(total - 1u ? total - 1u : 1u);
+			dst->f32[i] = src->f32[i] * (1.0f - t) + dst->f32[i] * t;
+		}
+		break;
+	case 2: /* int32 */
+	case 4: /* int8_24 */
+		for (i = 0; i < total; i++)
+		{
+			float t = (float)i / (float)(total - 1u ? total - 1u : 1u);
+			dst->s32[i] = (int32_t)((float)src->s32[i] * (1.0f - t) + (float)dst->s32[i] * t);
+		}
+		break;
+	default:
+		break; /* packed 24 bit: leave the new output as is */
+	}
+}
