diff -ruN '--exclude=*.o' src-baseline/Main/libjamesdsp/jni/jamesdsp/jdsp_state.c src/Main/libjamesdsp/jni/jamesdsp/jdsp_state.c
--- src-baseline/Main/libjamesdsp/jni/jamesdsp/jdsp_state.c	1970-01-01 08:00:00.000000000 +0800
+++ src/Main/libjamesdsp/jni/jamesdsp/jdsp_state.c	2026-10-24 15:03:41.013440381 +0800
@@ -0,0 +1,1387 @@
+/*
+ * jdsp_state.c - persistent DSP state for the JamesDSP effect library.
+ *
+ * Rationale: audioserver instantiates this effect from audio_effects.xml as a
+ * postprocess device effect.  That instance has no client handle, so the
+ * Android app can never call setParameter() on it.  The library therefore
+ * records every state changing command it successfully applies and replays the
+ * recorded sequence from EFFECT_CMD_INIT (and again whenever the sampling rate
+ * changes, because PEQ/loudness coefficients depend on it).  Result: the user's
+ * last settings keep working even when the app is gone.
+ *
+ * Design constraints:
+ *   - never crash, never block the audio thread: every failure path falls back
+ *     to the compiled in defaults;
+ *   - atomic persistence: the whole file is rewritten to <path>.tmp.<pid>,
+ *     fsync()ed (rate limited) and rename()d over the old file;
+ *   - bounded: per record 1 MiB, per chunked transfer group 2 MiB, 8 MiB total;
+ *   - replay reuses the existing command handler, no second parser.
+ *
+ * See jdsp_state.h for the file format and the environment switches.
+ */
+
+#include "jdsp_state.h"
+
+#include <errno.h>
+#include <fcntl.h>
+#include <poll.h>
+#include <pthread.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/inotify.h>
+#include <sys/stat.h>
+#include <sys/types.h>
+#include <time.h>
+#include <unistd.h>
+
+#if JDSP_STATE_ENABLE
+
+/* ------------------------------------------------------------------------- */
+/* logging                                                                   */
+/* ------------------------------------------------------------------------- */
+
+#if defined(__ANDROID__)
+#include <android/log.h>
+#define JDSP_STATE_TAG "JamesDSPState"
+#define STATE_LOGV(...) __android_log_print(ANDROID_LOG_DEBUG, JDSP_STATE_TAG, __VA_ARGS__)
+#define STATE_LOGI(...) __android_log_print(ANDROID_LOG_INFO, JDSP_STATE_TAG, __VA_ARGS__)
+#define STATE_LOGW(...) __android_log_print(ANDROID_LOG_WARN, JDSP_STATE_TAG, __VA_ARGS__)
+#else /* host build: used by the off-device unit test */
+static int state_debug_enabled(void);
+#define STATE_LOGV(...)                                                       \
+    do {                                                                      \
+        if (state_debug_enabled()) {                                          \
+            fprintf(stderr, "[jdsp-state] " __VA_ARGS__);                     \
+            fputc('\n', stderr);                                              \
+        }                                                                     \
+    } while (0)
+#define STATE_LOGI(...) STATE_LOGV(__VA_ARGS__)
+#define STATE_LOGW(...)                                                       \
+    do {                                                                      \
+        fprintf(stderr, "[jdsp-state] WARN: " __VA_ARGS__);                   \
+        fputc('\n', stderr);                                                  \
+    } while (0)
+#endif
+
+/* ------------------------------------------------------------------------- */
+/* tunables                                                                  */
+/* ------------------------------------------------------------------------- */
+
+#define JDSP_STATE_VERSION 1u
+#define JDSP_STATE_HEADER_BYTES 16u
+#define JDSP_STATE_TRAILER_BYTES 4u
+#define JDSP_STATE_MIN_FILE_BYTES (JDSP_STATE_HEADER_BYTES + JDSP_STATE_TRAILER_BYTES)
+
+/* Hard limits.  The file is a cache of user settings, not a database: staying
+ * small keeps the atomic rewrite cheap.  All of them can be overridden at build
+ * time, which the off-device unit test uses to reach the eviction paths. */
+#ifndef JDSP_STATE_MAX_TOTAL_BYTES
+#define JDSP_STATE_MAX_TOTAL_BYTES (8u * 1024u * 1024u)
+#endif
+#ifndef JDSP_STATE_MAX_FILE_BYTES
+#define JDSP_STATE_MAX_FILE_BYTES (JDSP_STATE_MAX_TOTAL_BYTES + (1024u * 1024u))
+#endif
+#ifndef JDSP_STATE_MAX_RECORDS
+#define JDSP_STATE_MAX_RECORDS 8192u
+#endif
+/* A chunked transfer (convolver impulse, EEL/DDC/ArbEQ string) is persisted as
+ * a group; groups larger than this are skipped as a whole so a replay can never
+ * produce a half loaded impulse. */
+#ifndef JDSP_STATE_MAX_GROUP_BYTES
+#define JDSP_STATE_MAX_GROUP_BYTES (2u * 1024u * 1024u)
+#endif
+#define JDSP_STATE_PATH_MAX 512
+#define JDSP_STATE_FSYNC_INTERVAL_MS 500u
+
+#define JDSP_STATE_PCMD_NONE 0xFFFFFFFFu
+#define JDSP_STATE_HASH_BASIS 0xCBF29CE484222325ull
+#define JDSP_STATE_HASH_PRIME 0x100000001B3ull
